; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SurvivalHorrorGame"
run/main_scene="uid://bevncfp36tr17"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*uid://cncnsnoxccxrs"
InputManager="*uid://tbcfpi04lslb"
CombinationManager="*uid://c0bs5h6dwtnrt"
Globals="*uid://db8sm0s4c5tai"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/resizable=false
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/anthonyec.camera_preview/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "purple",
"res://globals/": "red",
"res://main_scene/": "gray",
"res://scenes/": "blue",
"res://scenes/camera/": "orange",
"res://scenes/enemies/": "red",
"res://scenes/interactable/": "yellow",
"res://scenes/interactable/doors/": "green",
"res://scenes/interactable/intractable_template/": "gray",
"res://scenes/interactable/item_box/": "yellow",
"res://scenes/interactable/item_pickup/": "orange",
"res://scenes/interactable/misc/": "pink",
"res://scenes/items/": "yellow",
"res://scenes/items/item_combinations/": "red",
"res://scenes/items/item_resources/1xx_weapons/": "red",
"res://scenes/items/item_resources/3xx_recovery/": "green",
"res://scenes/items/item_resources/4xx_key_items/": "blue",
"res://scenes/items/item_resources/5xx_other/": "gray",
"res://scenes/player/": "green",
"res://scenes/rooms/": "blue",
"res://scenes/rooms/room_template/": "gray",
"res://scenes/rooms/test_room/": "purple",
"res://scenes/ui/": "teal",
"res://scenes/ui/examination_text/": "green",
"res://scenes/ui/inventory/": "teal",
"res://scenes/ui/inventory/item_examination/": "yellow",
"res://scenes/ui/inventory/sub_menu_buttons/": "red",
"res://scenes/ui/map/": "blue",
"res://scenes/ui/menu_nav_bar/": "yellow",
"res://scenes/ui/notes/": "orange",
"res://scenes/ui/pause_screen/": "gray",
"res://testing/": "purple"
}

[filesystem]

import/blender/enabled=false

[global_group]

fixed_cameras=""

